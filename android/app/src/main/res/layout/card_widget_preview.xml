<?xml version="1.0" encoding="utf-8"?>
<!-- Static sample of the card style, shown by the widget picker on Android 12 and later. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/course_widget_background"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="@dimen/course_widget_footer_gap">

    <RelativeLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/course_widget_preview_date"
            android:textColor="@color/course_widget_content_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="@dimen/course_widget_header_gap"
            android:layout_toStartOf="@id/widget_date"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:text="@string/course_widget_preview_schedule_name"
            android:textColor="@color/course_widget_content_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/course_widget_header_gap"
            android:layout_toEndOf="@id/widget_date"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/course_widget_preview_week"
            android:textColor="@color/course_widget_content_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/course_1_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_marginTop="10dp"
        android:background="@color/course_widget_background">

        <ImageView
            android:id="@+id/course_1_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_preview_card"
            app:tint="@color/course_widget_preview_accent_1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/course_1_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_1_name"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/course_1_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_1_place"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/course_1_start_time"
                    style="@style/WidgetCourseTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/course_widget_preview_course_1_start"
                    android:textColor="@color/course_widget_preview_on_accent" />

                <TextView
                    android:id="@+id/course_1_end_time"
                    style="@style/WidgetCourseTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/course_widget_preview_course_1_end"
                    android:textColor="@color/course_widget_preview_on_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/course_2_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/course_1_card"
        android:layout_marginTop="8dp"
        android:background="@color/course_widget_background">

        <ImageView
            android:id="@+id/course_2_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_preview_card"
            app:tint="@color/course_widget_preview_accent_2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/course_2_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_2_name"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/course_2_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/course_widget_preview_course_2_place"
                    android:textColor="@color/course_widget_preview_on_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/course_2_start_time"
                    style="@style/WidgetCourseTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/course_widget_preview_course_2_start"
                    android:textColor="@color/course_widget_preview_on_accent" />

                <TextView
                    android:id="@+id/course_2_end_time"
                    style="@style/WidgetCourseTimeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/course_widget_preview_course_2_end"
                    android:textColor="@color/course_widget_preview_on_accent" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="@string/course_widget_remaining_sample"
        android:textColor="@color/course_widget_footer_text"
        android:textSize="14sp" />
</RelativeLayout>
